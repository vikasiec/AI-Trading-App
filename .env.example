# Copy this file to .env and fill in real values. Never commit .env.

# --- INDstocks (https://www.indstocks.com/app/api-trading/access-tokens) ---
INDSTOCKS_CLIENT_ID=            # x-api-key shown on the dashboard after TOTP setup
INDSTOCKS_MPIN=                 # your INDstocks account MPIN
INDSTOCKS_TOTP_SECRET=          # shown ONCE during TOTP setup -- store securely
INDSTOCKS_BASE_URL=https://api.indstocks.com
INDSTOCKS_TOKEN_CACHE=~/.indstocks/session_token.json

# --- Jev AI / TypeSafe (confirmed endpoint per api.typesafe.ai reference) ---
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONVICTION_THRESHOLD=0.80
JEV_CONFIDENCE_THRESHOLD=0.60
JEV_TIMEOUT_S=2.0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_OWNER_CHAT_ID=         # chat that may command the bot
TELEGRAM_OWNER_USER_ID=         # your user id (defaults to chat id); commands need CONFIRM

# --- Risk ---
DAILY_LOSS_LIMIT_PCT=0.02
MAX_POSITION_CAPITAL_INR=50000
MAX_POSITION_PCT_EQUITY=0.02
MAX_SLIPPAGE_PCT=0.0015
DEFAULT_TICK_SIZE_INR=0.05
PAPER_TRADING=true              # keep true until the pre-flight checklist in docs/ARCHITECTURE.md is complete

# --- Exit rules -- every position this bot opens is closed by one of these ---
STOP_LOSS_PCT=0.01              # exit if price falls 1% below entry
TARGET_PCT=0.02                 # exit if price rises 2% above entry
MAX_HOLD_MINUTES=375            # ~one NSE trading day; force-exit if still open this long
BROKERAGE_PER_ORDER_INR=5.0     # INDstocks' confirmed flat per-order rate, used in cost calculations

# --- Portfolio-level risk -- caps across ALL open positions at once, not just one order ---
MAX_CONCURRENT_POSITIONS=3
MAX_DEPLOYED_CAPITAL_PCT=0.10   # total capital across all open positions, as a fraction of equity
MAX_SECTOR_CAPITAL_PCT=0.06     # cap on capital in one sector (static map in sectors.py)

# --- GTT / exchange-side bracket orders -- confirm INDstocks' real Smart Orders API before enabling; see gtt_orders.py ---
GTT_ENABLED=false

# --- Intelligence ---
ENTRY_MODE=jev                  # jev | rule | jev_and_rule
OPEN_SKIP_MINUTES=15            # no new entries this many minutes after 09:15 IST
INDEX_SCRIP=NSE_26000           # Nifty-style scrip for V7; ignored if quote fails
INDEX_VETO_ENABLED=true
INDEX_VETO_PCT=-0.8             # block new longs if index day change <= this (%)
GAP_SKIP_ABS_PCT=3.0            # skip if |session gap vs prior close| >= this %
JEV_NOISE_VETO=true
JEV_NOISE_THRESHOLD=0.70        # V10: skip if Jev noise score >= this

AUDIT_LOG_PATH=./audit_trail.jsonl
POSITIONS_STORE_PATH=~/.indstocks/open_positions.json

# --- Watchlist -- WATCHLIST_SYMBOLS wins if set, else WATCHLIST_FILE, else a small built-in default ---
WATCHLIST_SYMBOLS=                # comma-separated, e.g. RELIANCE,TCS,HDFCBANK
WATCHLIST_FILE=                   # path to a JSON file containing a list of symbols

# --- News ingestion -- comma-separated RSS/Atom feed URLs; leave blank to score on price data alone ---
NEWS_RSS_FEEDS=
NEWS_CACHE_TTL_S=300

# --- WebSocket market data -- confirm the real INDstocks protocol before enabling; see market_data.py ---
WEBSOCKET_ENABLED=false
INDSTOCKS_WEBSOCKET_URL=wss://ws-prices.indstocks.com/api/v1/ws/prices
RESPECT_SESSION=true            # false = trade 24/7 (don't)

# --- Ops ---
LOG_JSON=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
HEALTH_TOKEN=                   # required if HEALTH_HOST is not loopback
HEARTBEAT_INTERVAL_S=30
HEARTBEAT_FAILS_BEFORE_FLATTEN=5
HEARTBEAT_FLATTEN=false         # true + live: flatten after consecutive misses
