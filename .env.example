# Copy this file to .env and fill in real values. Never commit .env.

# --- INDstocks (https://www.indstocks.com/app/api-trading/access-tokens) ---
INDSTOCKS_CLIENT_ID=            # x-api-key shown on the dashboard after TOTP setup
INDSTOCKS_MPIN=                 # your INDstocks account MPIN
INDSTOCKS_TOTP_SECRET=          # shown ONCE during TOTP setup -- store securely
INDSTOCKS_BASE_URL=https://api.indstocks.com
INDSTOCKS_TOKEN_CACHE=~/.indstocks/session_token.json

# --- Jev AI / TypeSafe (confirmed endpoint per api.typesafe.ai reference) ---
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CONVICTION_THRESHOLD=0.80
JEV_CONFIDENCE_THRESHOLD=0.60
JEV_TIMEOUT_S=2.0

# --- Telegram ---
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_OWNER_CHAT_ID=         # your own chat id -- only this id can /halt the bot

# --- Risk ---
DAILY_LOSS_LIMIT_PCT=0.02
MAX_POSITION_CAPITAL_INR=50000
MAX_POSITION_PCT_EQUITY=0.02
MAX_SLIPPAGE_PCT=0.0015
DEFAULT_TICK_SIZE_INR=0.05
PAPER_TRADING=true              # keep true until the pre-flight checklist in docs/ARCHITECTURE.md is complete

# --- Exit rules -- every position this bot opens is closed by one of these ---
STOP_LOSS_PCT=0.01              # exit if price falls 1% below entry
TARGET_PCT=0.02                 # exit if price rises 2% above entry
MAX_HOLD_MINUTES=375            # ~one NSE trading day; force-exit if still open this long

AUDIT_LOG_PATH=./audit_trail.jsonl
POSITIONS_STORE_PATH=~/.indstocks/open_positions.json

# --- Watchlist -- WATCHLIST_SYMBOLS wins if set, else WATCHLIST_FILE, else a small built-in default ---
WATCHLIST_SYMBOLS=                # comma-separated, e.g. RELIANCE,TCS,HDFCBANK
WATCHLIST_FILE=                   # path to a JSON file containing a list of symbols

# --- News ingestion -- comma-separated RSS/Atom feed URLs; leave blank to score on price data alone ---
NEWS_RSS_FEEDS=
NEWS_CACHE_TTL_S=300

# --- WebSocket market data -- confirm the real INDstocks protocol before enabling; see market_data.py ---
WEBSOCKET_ENABLED=false
INDSTOCKS_WEBSOCKET_URL=wss://api.indstocks.com/market/stream
