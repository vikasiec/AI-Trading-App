[Unit]
Description=Refresh INDstocks access token (single owner)
After=network-online.target

[Service]
Type=oneshot
User=trader
Group=trader
WorkingDirectory=/opt/jev-trader
EnvironmentFile=/opt/jev-trader/.env
ExecStart=/opt/jev-trader/.venv/bin/python /opt/jev-trader/scripts/refresh_token.py
Nice=10
